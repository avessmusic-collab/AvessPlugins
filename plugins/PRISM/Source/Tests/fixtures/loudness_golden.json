{
  "description": "Golden loudness values for PRISM_Tests (test: loudness_golden_fixtures). Reference = libebur128 (via ffmpeg's ebur128 filter) with pyloudnorm as an integrated-loudness cross-check. The test SKIPs with a printed notice while 'values' is empty; once the generator below has been run, the test compares PRISM's integrated loudness and LRA against these values (+-0.05 LU integrated, +-0.1 LU LRA).",
  "how_to_generate": "From plugins/PRISM/Source/Tests/fixtures: save the 'generator' string to gen_golden.py (python3 -m pip install numpy scipy pyloudnorm; ffmpeg must be on PATH), then run: python3 gen_golden.py loudness_golden.json   -- it rewrites this file in place, filling 'values'.",
  "tolerances": {
    "integrated_lu": 0.05,
    "lra_lu": 0.1
  },
  "generator": "import json, re, subprocess, sys, tempfile, os\nimport numpy as np\nimport scipy.io.wavfile as wf\nimport pyloudnorm as pyln\n\npath = sys.argv[1]\nspec = json.load(open(path))\n\ndef render(sig):\n    fs = sig['fs']\n    chans = sig['channels']\n    blocks = []\n    n0 = 0\n    for seg in sig['segments']:\n        n = int(round(seg['seconds'] * fs))\n        t = (np.arange(n) + n0) / fs\n        if seg.get('level_dbfs_peak') is None:\n            x = np.zeros(n)\n        else:\n            x = 10 ** (seg['level_dbfs_peak'] / 20.0) * np.sin(2 * np.pi * seg['freq_hz'] * t)\n        b = np.zeros((n, chans))\n        for c, name in enumerate('LR'[:chans]):\n            if name in seg['channels']:\n                b[:, c] = x\n        blocks.append(b)\n        n0 += n\n    return np.concatenate(blocks)\n\ndef ffmpeg_ebur128(wav):\n    p = subprocess.run(['ffmpeg', '-nostats', '-hide_banner', '-i', wav, '-filter_complex', 'ebur128', '-f', 'null', '-'], capture_output=True, text=True)\n    tail = p.stderr.split('Summary:')[-1]\n    i = float(re.search(r'I:\\s+(-?[0-9.]+) LUFS', tail).group(1))\n    lra = float(re.search(r'LRA:\\s+(-?[0-9.]+) LU', tail).group(1))\n    return i, lra\n\nvalues = {}\nfor sig in spec['signals']:\n    data = render(sig)\n    with tempfile.TemporaryDirectory() as d:\n        wav = os.path.join(d, 'x.wav')\n        wf.write(wav, sig['fs'], data.astype(np.float32))\n        i, lra = ffmpeg_ebur128(wav)\n    meter = pyln.Meter(sig['fs'])\n    i_py = float(meter.integrated_loudness(data))\n    values[sig['name']] = {'integrated': i, 'lra': lra, 'integrated_pyloudnorm': i_py}\n    print(sig['name'], values[sig['name']])\n\nspec['values'] = values\njson.dump(spec, open(path, 'w'), indent=2)\n",
